{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "start-brand-web",
  "main": "worker.js",
  "compatibility_date": "2026-09-23",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": [
      "/campus",
      "/campus/*",
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "start-brand-campus",
      "database_id": "8ea65989-d835-4cbc-b71a-d6b612dbb513"
    }
  ]
}